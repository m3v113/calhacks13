// Live data model for the app (local SQLite).
// Grows feature by feature; the full target model is in plans/schema.prisma.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// F1: a Smart Inbox category, made by the AI or by you
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  auto      Boolean  @default(true) // false when you made it
  createdAt DateTime @default(now())

  items Item[]
}

// F1: anything captured in the Smart Inbox
model Item {
  id         String    @id @default(cuid())
  kind       String    @default("note") // "note" | "link" | "image" | "document"
  text       String // what you typed or pasted; the file name for uploads
  url        String? // first link found in the text
  title      String? // short title: the page title, or one the AI wrote
  titleBy    String? // "user" once you rename it; then it's never replaced
  summary    String? // page description, when the link could be read
  fileName   String? // uploads: original file name
  filePath   String? // uploads: path under data/uploads/
  mime       String? // uploads: file type
  extracted  String? // documents: text pulled out of the file
  overview   String? // the tray's summary: written by the AI, editable by you
  overviewBy String? // "ai" | "user"; the AI never rewrites a summary you edited
  notes      String? // your own notes on this item
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortedBy   String    @default("pending") // "pending" | "rules" | "sure" | "ai" | "user"
  aiTries    Int       @default(0) // AI runs in a row that didn't produce a summary; retries stop at 3
  dueDate    String? // "2026-10-26": with a date, time, or priority, it shows in the Tasks bar
  dueTime    String? // "17:00"
  priority   Int? // 1 high, 2 medium, 3 low
  done       Boolean   @default(false) // checked off in the Tasks bar
  doneAt     DateTime? // when, for the Done group
  projectId  String? // optional link to a project; it stays in its category too
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  archived   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([archived, createdAt])
}

// A project: a card on the Hub (F3) that opens to its own space (F4)
model Project {
  id         String   @id @default(cuid())
  title      String
  goal       String? // the sentence it was made from
  color      String?
  canvasX    Float    @default(0)
  canvasY    Float    @default(0)
  cardW      Float    @default(260) // card size on the Hub
  cardH      Float    @default(120)
  kind       String   @default("space") // "space" (you work in it) | "auto" (the AI breaks it into steps)
  context    String? // what you gave the AI to start an Auto project from
  overview   String? // no longer shown; kept so existing databases update without data loss
  overviewBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items    Item[]
  sections Section[]
  scouts   Scout[]
  linksOut ProjectLink[] @relation("from")
  linksIn  ProjectLink[] @relation("to")
}

// A line between two projects on the Hub. Linked projects share their sources.
model ProjectLink {
  id        String   @id @default(cuid())
  fromId    String
  from      Project  @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Project  @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  color     String?
  fromSide  String? // the circle the line was drawn from: "top" | "right" | "bottom" | "left"
  toSide    String? // the side of the other card it was dropped nearest to
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

// A block in a project space
model Section {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // "writing" | "tasks" | "sources" (the project's Pantry) | "resources" (Auto: links from a web search, read-only, JSON in notes) | "assistant" (ask the AI, JSON in notes) | "step" (older Auto); older: "notes", "items", "providers"
  proposed  Boolean  @default(false) // made by the AI and not yet kept
  title     String
  order     Int      @default(0)
  span      Int      @default(1) // 1 = half width, 2 = full width
  notes     String? // the text of a writing section (HTML)
  createdAt DateTime @default(now())

  tasks Task[]

  @@index([projectId, order])
}

model Task {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text      String
  detail    String? // how to do it (steps in Auto projects)
  proposed  Boolean  @default(false) // suggested by the AI and not yet approved
  done      Boolean  @default(false)
  doneAt    DateTime? // when it was checked off, for the Done group
  dueDate   String? // "2026-10-26": with a date, time, or priority, it shows in the Tasks bar too
  dueTime   String? // "17:00"
  priority  Int? // 1 high, 2 medium, 3 low
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sectionId, order])
}

// Links read online, kept so nothing is fetched twice
model PageCache {
  url       String   @id
  title     String?
  summary   String?
  text      String? // readable page text ("" when there was none); used for summaries
  ok        Boolean  @default(true)
  image     String? // the page's preview picture (og:image or a video thumbnail)
  via       String? // how it was read: "direct", "brightdata", "oembed", or "crossref"
  unlockTries Int    @default(0) // Bright Data requests made for this page (it's paid, so capped)
  fetchedAt DateTime @default(now())
}

// A Scout: a brief you run on demand. It searches and reads the web (or the project's sources)
// and gives back results you can keep.
model Scout {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String // "find" (options to compare) | "answer" (a write-up with citations) | "turn" (reshape pages into tasks, citations, a table)
  brief     String
  taskId    String? // the task it was sent from: checked off when the Scout finishes
  status    String   @default("idle") // idle | searching | reading | thinking | done | failed
  note      String? // progress, or what went wrong
  result    String? // JSON, its shape depends on the kind
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Search results from the Bright Data SERP API, so the same search isn't paid for twice.
model SearchCache {
  query     String   @id
  results   String // JSON: [{ title, link, description }]
  fetchedAt DateTime @default(now())
}
