# Local SQLite file (created by `npm run setup`)
DATABASE_URL="file:../data/app.db"

# Local AI
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
# Optional: the model that reads images. Without it, the smallest installed model that can see images is used.
