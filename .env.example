# Local SQLite file (created by `npm run setup`)
DATABASE_URL="file:../data/app.db"

# Local AI
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:4b"
# Optional: a different model for reading images. By default OLLAMA_MODEL reads them too.
# OLLAMA_VISION_MODEL="gemma3:4b"

# Optional: Bright Data Web Unlocker, a backup for sites that block reading (HTTP 403), like allrecipes.
# Only those pages' addresses are sent to Bright Data. Everything else stays on your Mac.
# BRIGHTDATA_API_KEY=""
# BRIGHTDATA_ZONE="web_unlocker1"
